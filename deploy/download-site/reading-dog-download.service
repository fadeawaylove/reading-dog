[Unit]
Description=Reading Dog HTTP downloads (isolated nginx)
After=network.target
[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /opt/reading-dog-download/nginx.conf
ExecStart=/usr/sbin/nginx -c /opt/reading-dog-download/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /opt/reading-dog-download/nginx.conf -s reload
Restart=on-failure
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
